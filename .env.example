# Deployment
COMPOSE_PROJECT_NAME=nero-test

# PostgreSQL
POSTGRES_DB=nero
POSTGRES_USER=nero_admin
POSTGRES_PASSWORD=nero_admin # change this to a strong password in production

# Account
ACCOUNT_DB_USER=account_app
ACCOUNT_DB_PASSWORD=account_dev # change this to a strong password in production
ACCOUNT_APP_SECRET= # You can generate a new one with: openssl rand -hex 32

# First admin, created on first start only (skipped once an admin exists)
ADMIN_NAME=Admin
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@nero.local
ADMIN_PASSWORD=nero_admin_dev # change this to a strong password in production (min. 8 characters)

# Workout
WORKOUT_DB_USER=workout_app
WORKOUT_DB_PASSWORD=workout_dev # change this to a strong password in production

# Statistics
REDIS_PASSWORD= # You can generate a new one with: openssl rand -hex 32

# Frontend
FRONT_PORT=3000
AUTH_COOKIE_PREFIX=nero # prefix for auth cookies, e.g. "nero" will create "nero_access_token" and "nero_refresh_token"
AUTH_COOKIE_SECURE=false # false if app is running on http, true if running on https
STATS_SCRIPT_URL=
STATS_WEBSITE_ID=
